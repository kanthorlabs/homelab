[Unit]
Description=Write the CPU, RAM and disk usage and the CPU temperature of the homelab for its homepage

[Service]
Type=oneshot
ExecStart=/usr/local/lib/homelab/collect-stats /run/homelab-stats/stats.json
User=homelab-stats
Group=homelab-stats
RuntimeDirectory=homelab-stats
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateNetwork=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
